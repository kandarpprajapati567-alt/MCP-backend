# Public application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase public project credentials (safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
# Required only by isolated server-side AI provider secret storage.
SUPABASE_SECRET_KEY=
AI_PROVIDER_ENCRYPTION_KEY=

# SERPER_API_KEY=
# MCP_DEV_TOKEN=
# MCP_ALLOW_DEV_TOKEN=false

NODE_ENV=development
