# Public application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase public project credentials (safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
# Do not add the service_role / secret key to this app unless a future
# isolated admin-only operation explicitly requires it.
# SERPER_API_KEY=
# MCP_DEV_TOKEN=
# MCP_ALLOW_DEV_TOKEN=false

NODE_ENV=development
